---
import { type Locale, localizedPath } from "@/i18n"
import ResponsiveImage from "./ResponsiveImage.astro"
import { formatDate } from "./site"

interface Props {
  locale: Locale
  slug: string
  title: string
  description?: string
  date: Date | string
  hero?: string
  cta: string
}

const { locale, slug, title, description, date, hero, cta } = Astro.props
const imagePath = hero
  ? slug === "orca-tools"
    ? `/img/projects/${slug}/${hero}`
    : `/img/projects/${hero}`
  : undefined
---

<a class="project-card" href={localizedPath(locale, `/projects/${slug}/`)} data-reveal="rise">
  {imagePath && <ResponsiveImage class="project-card__image" src={imagePath} alt="" />}
  <div class="project-card__body">
    <div class="project-card__heading">
      <h2>{title}</h2>
      <time datetime={new Date(date).toISOString()}>{formatDate(date, locale)}</time>
    </div>
    {description && <p set:html={description} />}
    <span class="project-card__link">{cta} <span aria-hidden="true">→</span></span>
  </div>
</a>
