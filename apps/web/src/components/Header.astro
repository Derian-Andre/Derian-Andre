---
import {
  getTranslations,
  type Locale,
  locales,
  localizedPath,
  stripLocalePrefix,
} from "@/i18n"
import BrandMark from "./BrandMark.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const translations = getTranslations(locale)
const currentPath = Astro.url.pathname
const pathWithoutLocale = stripLocalePrefix(currentPath)
const alternateLocales = locales.filter((candidate) => candidate !== locale)
const routeKey = pathWithoutLocale.replace(/^\/+|\/+$/g, "").split("/")[0] || "home"
const routeParts = pathWithoutLocale.replace(/^\/+|\/+$/g, "").split("/").filter(Boolean)
const isArticle = routeKey === "blog" && routeParts.length > 1 && routeParts[1] !== "page"
const isWorkCase = routeKey === "work" && routeParts.length > 1
const routeIndex: Record<string, string> = { work: isWorkCase ? "01" : "04", projects: "02", blog: isArticle ? "04" : "03", about: "05", services: "06", curriculum: "07", "404": "404" }
const routeLabel: Record<string, string> = { work: isWorkCase ? (locale === "es" ? "Caso" : "Case") : (locale === "es" ? "Trabajo" : "Work"), projects: locale === "es" ? "Proyectos" : "Projects", blog: isArticle ? (locale === "es" ? "Artículo" : "Article") : "Blog", about: "Ego", services: translations.header.services, curriculum: locale === "es" ? "Curriculum Vitae" : "Curriculum Vitae", "404": locale === "es" ? "Error en la matrix" : "Error" }
const pageIndex = routeIndex[routeKey]
const menu = [
  { key: "work", path: "/work/", label: locale === "es" ? "Trabajo" : "Work" },
  { key: "projects", path: "/projects/", label: locale === "es" ? "Proyectos" : "Projects" },
  { key: "blog", path: "/blog/", label: translations.header.blog },
  { key: "about", path: "/about/", label: translations.header.about },
  { key: "services", path: "/services/", label: translations.header.services },
  { key: "curriculum", path: "/curriculum/", label: "CV" },
] as const
---

<header class="site-header" data-site-header>
  <div class="site-header__top">
    <a class="site-logo" href={localizedPath(locale, "/")} aria-label="Derian André">
      <span class="sr-only">Derian André Castillo Franco</span>
      <BrandMark />
    </a>
    {pageIndex && <span class="site-header__page"><i>{pageIndex}</i><b>{routeLabel[routeKey]}</b></span>}
  </div>

  <div class="site-header__navigation">
    <nav class="site-navigation" aria-label={locale === "es" ? "Navegación principal" : "Primary navigation"}>
      {
        menu.map((item) => {
          const href = localizedPath(locale, item.path);
          const normalizedCurrent = currentPath.replace(/\/$/, "") || "/";
          const normalizedHref = href.replace(/\/$/, "") || "/";
          const active =
            normalizedCurrent === normalizedHref || normalizedCurrent.startsWith(`${normalizedHref}/`);

          return (
            <a class="site-navigation__item" href={href} aria-current={active ? "page" : undefined}>
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="site-header__locale">{alternateLocales.map((alternateLocale) => <a href={localizedPath(alternateLocale, pathWithoutLocale)} hreflang={alternateLocale} lang={alternateLocale}>{alternateLocale.toUpperCase()}</a>)}</div>
  </div>
</header>
