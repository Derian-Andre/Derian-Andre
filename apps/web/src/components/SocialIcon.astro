---
interface Props {
  name: "instagram" | "linkedin" | "github" | "mail" | "whatsapp"
}

const { name } = Astro.props
---

<svg
  class="social-icon"
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="1.8"
>
  {
    name === "instagram" && (
      <>
        <rect width="20" height="20" x="2" y="2" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <path d="M17.5 6.5h.01" />
      </>
    )
  }
  {
    name === "linkedin" && (
      <>
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" />
        <rect width="4" height="12" x="2" y="9" />
        <circle cx="4" cy="4" r="2" />
      </>
    )
  }
  {
    name === "github" && (
      <>
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.28-.36 6.72-1.61 6.72-7.25A5.65 5.65 0 0 0 19.22 3.3 5.27 5.27 0 0 0 19.08 1S17.9.65 15 2.48a13.38 13.38 0 0 0-7 0C5.1.65 3.92 1 3.92 1a5.27 5.27 0 0 0-.14 2.3 5.65 5.65 0 0 0-1.5 3.95c0 5.63 3.44 6.88 6.72 7.25A4.8 4.8 0 0 0 8 18v4" />
        <path d="M8 19c-3 .92-3-1.5-4-2" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect width="20" height="16" x="2" y="4" rx="2" />
        <path d="m22 7-10 7L2 7" />
      </>
    )
  }
  {
    name === "whatsapp" && (
      <>
        <path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.45L3 21l2.05-5.4A8.5 8.5 0 1 1 21 11.5Z" />
        <path d="M8.7 8.5c.2-.5.5-.5.9-.5h.5c.2 0 .4.1.5.4l.9 2c.1.3.1.5-.1.7l-.7.9c-.1.2-.2.3 0 .6.5.9 1.3 1.7 2.3 2.2.3.2.5.1.7-.1l1-.8c.2-.2.5-.2.8-.1l1.9.9c.3.1.4.3.4.6v.5c0 .5-.2.9-.6 1.2-.4.3-1.2.6-2.2.5-1-.1-2.7-.6-4.6-2.3-1.5-1.3-2.5-3-2.8-4.2-.3-1.1-.1-2 .2-2.5Z" />
      </>
    )
  }
</svg>
