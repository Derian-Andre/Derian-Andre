---
import type { Locale } from "@/i18n"
import SocialIcon from "./SocialIcon.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const links = [
  { label: "Instagram", icon: "instagram", href: "https://instagram.com/DerianAndre" },
  { label: "LinkedIn", icon: "linkedin", href: "https://linkedin.com/in/DerianAndre" },
  { label: "GitHub", icon: "github", href: "https://github.com/DerianAndre" },
  {
    label: locale === "es" ? "Correo" : "Email",
    icon: "mail",
    href: "mailto:hola@derianandre.com",
  },
  {
    label: "WhatsApp",
    icon: "whatsapp",
    href: `https://wa.me/523312781411?text=${encodeURIComponent(
      locale === "es"
        ? "¡Hola, me contacto desde tu portafolio!"
        : "Hello, I am contacting you from your portfolio!",
    )}`,
  },
] as const
---

<footer class="social-links" aria-label={locale === "es" ? "Redes sociales" : "Social media"}>
  {
    links.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer nofollow" aria-label={link.label}>
        <SocialIcon name={link.icon} />
      </a>
    ))
  }
</footer>
