---
import {
  type CurriculumCredentialProvider,
  type CurriculumSkillGroup,
  curriculumData,
} from "../../data/curriculum"
import { getTranslations, type Locale, localizedPath } from "../../i18n"
import SocialIcon from "../SocialIcon.astro"
import "../../styles/curriculum.css"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const translations = getTranslations(locale)
const copy = translations.curriculum

interface ExperienceItemCopy {
  title: string
  subtitle: string
  description: string
}

interface ExperienceSectionCopy {
  title: string
  [slug: string]: string | ExperienceItemCopy
}

const experienceCopy = copy.experience as unknown as Record<string, unknown>
const sectionCopy = (slug: string) => experienceCopy[slug] as ExperienceSectionCopy
const skillCopy = copy.about.skills as Record<string, string>

const contactMarks: Record<string, string> = {
  "geo-alt-fill": "⌖",
  "envelope-fill": "@",
}

const formatDate = (value: string) =>
  new Intl.DateTimeFormat(locale, {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(value))

const formatIssuedDate = (value: string) =>
  new Intl.DateTimeFormat(locale, {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${value}-01T00:00:00.000Z`))

const credentialIdLabel = locale === "es" ? "ID de credencial" : "Credential ID"
const issuedLabel = locale === "es" ? "Expedición" : "Issued"

const iconTitles: Record<string, string> = {
  "adobe-illustrator": "Adobe Illustrator",
  "adobe-indesign": "Adobe InDesign",
  "adobe-photoshop": "Adobe Photoshop",
  angular: "Angular",
  "atlassian-bitbucket": "Bitbucket",
  "atlassian-confluence": "Confluence",
  "atlassian-jira": "Jira",
  "agentic-workflows": "Agentic workflows and custom agent harnesses",
  aws: "AWS",
  casl: "CASL authorization",
  claude: "Claude",
  cloudflare: "Cloudflare",
  codex: "OpenAI Codex",
  cursor: "Cursor",
  docker: "Docker",
  drizzle: "Drizzle ORM",
  css: "CSS",
  express: "Express",
  figma: "Figma",
  git: "Git",
  github: "GitHub",
  githubactions: "GitHub Actions",
  gitlab: "GitLab",
  graphql: "GraphQL",
  higgsfield: "Higgsfield",
  html: "HTML5",
  hono: "Hono",
  javascript: "JavaScript",
  jest: "Jest",
  jquery: "jQuery",
  kimi: "Kimi",
  "microsoft-azure": "Microsoft Azure",
  "microsoft-azure-devops": "Azure DevOps",
  mongodb: "MongoDB",
  "model-context-protocol": "MCP connectors",
  mongoose: "Mongoose",
  mysql: "MySQL",
  next: "Next.js",
  n8n: "n8n",
  node: "Node.js",
  nestjs: "NestJS",
  nuxt: "Nuxt",
  "power-bi": "Power BI",
  pnpm: "pnpm",
  python: "Python",
  prisma: "Prisma",
  "prompt-engineering": "Prompt engineering",
  qwen: "Qwen",
  react: "React",
  "rest-api": "REST API",
  sass: "Sass",
  security: "Application security",
  sonarqube: "SonarQube",
  socketdotio: "Socket.IO",
  slack: "Slack",
  sql: "SQL",
  trello: "Trello",
  troubleshooting: "Problem solving",
  typescript: "TypeScript",
  typeorm: "TypeORM",
  veracode: "Veracode",
  vscode: "Visual Studio Code",
  vue: "Vue.js",
  zapier: "Zapier",
  "z-ai": "Z.ai",
}

const iconTitle = (name: string) => iconTitles[name] ?? name

const skillGroups = curriculumData.skills as readonly CurriculumSkillGroup[]
const providers = curriculumData.certifications as readonly CurriculumCredentialProvider[]
---

<section class="cv-page" aria-labelledby="curriculum-title">
	<header class="cv-title-rail">
		<span>{copy.title}</span>
		<h1 id="curriculum-title">Derian André <em>Castillo Franco</em></h1>
		<p>{copy.about.lead}</p>
	</header>

	<section class="cv-content">
		<div class="cv-columns">
			<aside class="cv-about" aria-labelledby="cv-profile-heading">
				<section>
					<h3 id="cv-profile-heading">{copy.about.contact.title}</h3>
					<ul class="cv-contact-list">
						{curriculumData.contact.map((item) => (
							<li>
								<span class:list={{ "cv-contact-icon": true, "cv-contact-icon--social": item.icon === "github" || item.icon === "linkedin" }} title={item.title} aria-hidden="true">
									{item.icon === "github" || item.icon === "linkedin" ? <SocialIcon name={item.icon} /> : (contactMarks[item.icon] ?? "·")}
								</span>
								<a href={item.url} target={item.url.startsWith("http") ? "_blank" : undefined} rel={item.url.startsWith("http") ? "noopener noreferrer nofollow" : undefined}>
									{item.title}
								</a>
							</li>
						))}
					</ul>
					<hr />
				</section>

				<section>
					<h3>{copy.about.languages.title}</h3>
					{curriculumData.languages.map((language) => (
						<h4>
							{copy.about.languages[language].title}
							<small>{copy.about.languages[language].level}</small>
						</h4>
					))}
					<hr />
				</section>

				<section>
					<h3>{copy.about.skills.title}</h3>
					{skillGroups.map((skill) => (
						<div class="cv-skill-group">
							<h4>
								{skillCopy[skill.slug]}
								{skill.years !== undefined && <small>{locale === "es" ? `${skill.years} años` : `${skill.years} years`}</small>}
							</h4>
							<div class="cv-skill-icons">
								{skill.items.map((name) => {
									const label = iconTitle(name)
									return <span class="cv-icon-tooltip" tabindex="0" role="img" aria-label={label} data-tooltip={label}>
										<img src={`/img/curriculum/icons/${name}.svg`} alt="" title={label} loading="lazy" />
									</span>
								})}
							</div>
						</div>
					))}
				</section>
			</aside>

			<div class="cv-experience">
				<h2>{copy.experience.title}</h2>
				<p class="cv-intro">{copy.experience.lead}</p>
				<nav class="cv-actions" aria-label={locale === "es" ? "Enlaces del currículum" : "Curriculum links"}>
					<a class="cv-action" href="/documents/derian-castillo-resume.pdf" download>{locale === "es" ? "Descargar resumen" : "Download resume"}</a>
					<a class="cv-action" href="/documents/derian-castillo-cv.pdf" download>{locale === "es" ? "Descargar CV" : "Download CV"}</a>
					<a class="cv-action" href={localizedPath(locale, "/projects")}>{translations.projects.title}</a>
					<a class="cv-action" href={localizedPath(locale, "/blog")}>{translations.blog.title}</a>
				</nav>
				<hr />

				<div class="cv-experience-content">
					{curriculumData.experience.map((section) => (
						<section class="cv-experience-section" aria-labelledby={`cv-${section.slug}`}>
							<h3 id={`cv-${section.slug}`}>{sectionCopy(section.slug).title}</h3>
							{section.items.map((item) => {
								const itemCopy = sectionCopy(section.slug)[item.slug] as ExperienceItemCopy
								return (
									<article class="cv-entry">
										<img class="cv-entry-logo" src={`/img/curriculum/${item.slug}.svg`} alt="" title={itemCopy.title} loading="lazy" />
										<h4>{itemCopy.title}</h4>
										<h5>{itemCopy.subtitle}</h5>
										<h6>
											<time datetime={item.dateStart}>{formatDate(item.dateStart)}</time>
											{" — "}
											{item.dateEnd ? <time datetime={item.dateEnd}>{formatDate(item.dateEnd)}</time> : <span>{copy.experience.current}</span>}
										</h6>
										<div class="cv-entry-description" set:html={itemCopy.description} />
										<div class="cv-entry-stack">
											{item.stack.map((name) => (
												<img src={`/img/curriculum/icons/${name}.svg`} alt="" title={iconTitle(name)} loading="lazy" />
											))}
										</div>
									</article>
								)
							})}
						</section>
					))}

					<section class="cv-credentials" aria-labelledby="cv-certifications">
						<h3 id="cv-certifications">{copy.experience.certifications.title}</h3>
						{providers.map((provider) => (
							<section class="cv-provider">
								{provider.logo ? (
									<div class="cv-provider-heading">
										<img class="cv-provider-logo" src={`/img/curriculum/${provider.logo}.svg`} alt={provider.title} title={provider.title} loading="lazy" />
										{provider.logoText && <h4 class="cv-provider-title">{provider.title}</h4>}
									</div>
								) : (
									<h4 class="cv-provider-title">{provider.title}</h4>
								)}
								<div class="cv-credential-grid">
									{provider.items.map((item) => {
										const mark = item.icon
											? { source: `/img/curriculum/icons/${item.icon}.svg`, title: iconTitle(item.icon), provider: false }
											: provider.logo
												? { source: `/img/curriculum/${provider.logo}.svg`, title: provider.title, provider: true }
												: null

										return <article class="cv-credential-card">
											<div class="cv-credential-heading">
												{mark && <img class:list={{ "cv-credential-mark": true, "cv-credential-mark--provider": mark.provider }} src={mark.source} alt="" title={mark.title} loading="lazy" />}
												<h5>{item.url ? <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a> : item.title}</h5>
											</div>
											<h6>{issuedLabel}: <time datetime={item.issued}>{formatIssuedDate(item.issued)}</time></h6>
											{item.credentialId && <p class="cv-credential-id"><span>{credentialIdLabel}:</span> <code>{item.credentialId}</code></p>}
										</article>
										})}
								</div>
							</section>
						))}
					</section>
				</div>
			</div>
		</div>
	</section>
</section>
