</style>

<script is:inline define:vars={{ globeWork, locale, generation: copy.generation }}>
  const homeRoot = document.querySelector(".sintesis-home-ref")
  if (homeRoot) {
    const homeReduced = matchMedia("(prefers-reduced-motion: reduce)").matches
    const homeBackground = homeRoot.querySelector("[data-sintesis-background]")
    const homeMonolith = homeRoot.querySelector("[data-sintesis-monolith]")
    const homeField = homeRoot.querySelector("[data-sintesis-field]")
    const homeGlobe = homeRoot.querySelector("[data-sintesis-globe]")
    const homeGeneration = homeRoot.querySelector("[data-home-generation]")
    const homeClock = homeRoot.querySelector("[data-home-clock]")
    const homePanel = homeRoot.querySelector("[data-globe-panel]")
    const homeCaseLink = homeRoot.querySelector("[data-globe-case-link]")
    const homeSections = [...homeRoot.querySelectorAll("[data-bg]")]

    const setWork = (index) => {
      const item = globeWork[index] ?? globeWork[0]
      homeRoot.querySelector("[data-globe-index]").textContent = `${String(index + 1).padStart(2, "0")} / ${String(globeWork.length).padStart(2, "0")}`
      homeRoot.querySelector("[data-globe-title]").textContent = item.title
      homeRoot.querySelector("[data-globe-meta]").textContent = `${item.kind} · ${item.year}`
      homeRoot.querySelector("[data-panel-index]").textContent = `${String(index + 1).padStart(2, "0")} — ${item.kind}, ${item.year}`
      homeRoot.querySelector("[data-panel-title]").textContent = item.title
      if (homeCaseLink) homeCaseLink.href = item.href
    }

    const updateClock = () => {
      if (homeClock) homeClock.textContent = new Intl.DateTimeFormat("es-MX", { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false, timeZone: "America/Mexico_City" }).format(new Date())
    }
    updateClock()
    window.setInterval(updateClock, 1000)

    const designWord = homeRoot.querySelector("[data-sintesis-design]")
    homeRoot.querySelector(".home-ref-design")?.addEventListener("pointermove", (event) => {
      if (!designWord) return
      const rect = event.currentTarget.getBoundingClientRect()
      const position = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width))
      designWord.style.fontWeight = String(Math.round(300 + position * 600))
      designWord.style.letterSpacing = `${(-0.02 - position * 0.05).toFixed(3)}em`
    })

    Promise.all([import("/scenes/fondo.js"), import("/scenes/v2/monolito.js"), import("/scenes/v2/campo.js"), import("/scenes/v2/globo.js")]).then(async ([background, monolith, field, globe]) => {
      const scene = homeBackground ? background.mount(homeBackground, { reduced: homeReduced }) : null
      let fieldApi = null
      let activeSection = null
      let sectionFrame = 0

      const applySection = (section, force = false) => {
        if (!section || (!force && section === activeSection)) return
        activeSection = section
        scene?.setMode(Number(section.getAttribute("data-bg") ?? 0))

        const particle = section.getAttribute("data-particle")
        if (particle) {
          fieldApi?.setShape(particle)
          homeField?.setAttribute("data-particle-shape", particle)
        }
      }

      const currentSection = () => {
        const marker = innerHeight * 0.5
        return homeSections.reduce((closest, section) => {
          const rect = section.getBoundingClientRect()
          const distance = marker < rect.top ? rect.top - marker : marker > rect.bottom ? marker - rect.bottom : 0
          const closestRect = closest.getBoundingClientRect()
          const closestDistance = marker < closestRect.top ? closestRect.top - marker : marker > closestRect.bottom ? marker - closestRect.bottom : 0
          return distance < closestDistance ? section : closest
        }, homeSections[0])
      }

      const syncSection = () => {
        sectionFrame = 0
        applySection(currentSection())
      }
      const queueSectionSync = () => {
        if (!sectionFrame) sectionFrame = requestAnimationFrame(syncSection)
      }

      const modeObserver = new IntersectionObserver(queueSectionSync, { rootMargin: "-49% 0px -49% 0px", threshold: 0 })
      homeSections.forEach((section) => modeObserver.observe(section))
      addEventListener("scroll", () => { scene?.setScroll(scrollY); queueSectionSync() }, { passive: true })
      addEventListener("resize", queueSectionSync, { passive: true })
      syncSection()

      const hero = homeMonolith ? monolith.mount(homeMonolith, {
        target: homeRoot.querySelector(".home-ref-hero"), reduced: homeReduced,
        onGen: (index, name) => { if (homeGeneration) homeGeneration.textContent = `${generation} ${String(index + 1).padStart(2, "0")} / 05 — ${name}` },
      }) : null
      homeRoot.querySelector("[data-sintesis-burst]")?.addEventListener("click", () => hero?.burst?.())
      if (homeField) {
        fieldApi = await field.mount(homeField, { target: homeRoot.querySelector(".home-ref-chapter-area"), reduced: homeReduced })
        fieldApi.setShape("cloud")
        applySection(activeSection ?? currentSection(), true)
      }
      if (!homeGlobe) return

      let visibleIndex = 0
      const globeApi = globe.mount(homeGlobe, {
        images: globeWork.map((item) => item.image), reduced: homeReduced, initialIndex: 0, target: homeRoot.querySelector(".home-ref-work-sticky"),
        onFront: (index) => { visibleIndex = index; setWork(index) },
        onSelect: (index) => { if (index < 0) { homePanel.hidden = true; return }; visibleIndex = index; setWork(index); homePanel.hidden = false },
      })
      homeRoot.querySelector("[data-globe-prev]")?.addEventListener("click", () => globeApi.nudge(-1))
      homeRoot.querySelector("[data-globe-next]")?.addEventListener("click", () => globeApi.nudge(1))
      homeRoot.querySelector("[data-globe-close]")?.addEventListener("click", () => globeApi.close())
      addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") globeApi.nudge(-1)
        if (event.key === "ArrowRight") globeApi.nudge(1)
        if (event.key === "Enter") globeApi.selectFront()
        if (event.key === "Escape") globeApi.close()
      })
      setWork(visibleIndex)
    })
  }
</script>
