    }
    .home-ref-design>.home-ref-number,
    .home-ref-design h2,
    .home-ref-design-columns { position:static; margin:0; }
    .home-ref-design>.home-ref-number { grid-row:1; }
    .home-ref-design h2 {
      grid-row:2;
      max-width:6.3ch;
      color:var(--body-color-high);
