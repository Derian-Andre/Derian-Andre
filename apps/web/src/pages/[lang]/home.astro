---
import { getCollection } from "astro:content"
import BrandMark from "@/components/BrandMark.astro"
import { getLocaleStaticPaths, isPublished, splitEntryId } from "@/components/site"
import { type Locale, localizedPath } from "@/i18n"
import BaseLayout from "@/layouts/BaseLayout.astro"

export function getStaticPaths() {
  return getLocaleStaticPaths()
}

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const essays = (await getCollection("blog"))
  .map((entry) => ({ entry, identity: splitEntryId(entry.id) }))
  .filter(({ entry, identity }) => identity?.locale === locale && isPublished(entry.data))
  .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf())
  .slice(0, 5)
const copy =
  locale === "es"
    ? {
        home: "Inicio",
        polymath: "ingeniero polímata",
        chapters: "Capítulos",
        ai: "IA & Software",
        design: "Diseño",
        philosophy: "Filosofía",
        work: "Trabajo",
        headline: "Inteligencia Artificial,",
        headlineEnd: "diseño y filosofía.",
        generation: "Generación",
        quantum: "Orbital cuántico",
        reload: "Recarga para otra · Clic para transformar",
        scroll: "Desplázate",
        applied: "Inteligencia aplicada",
        ideasHeadline: "Ideas que",
        production: "llegan",
        aiCopy:
          "Soy un desarrollador full-stack que crea productos útiles, claros y memorables. Trabajo con IA, software y diseño para que las ideas lleguen más lejos.",
        ready: "Listo",
        console: [
          "✓ del prototipo a producción",
          "✓ modelos de IA integrados con criterio",
          "✓ front-end rápido, accesible y hermoso",
          "✓ código mantenible, revisado y probado",
        ],
        build: "¿qué construimos juntos?",
        designKicker: "Marcas y experiencias que funcionan",
        branding: "Naming, identidad y rediseño de marcas con carácter.",
        product: "Interfaces y aplicaciones donde la forma sirve a la función.",
        image: "Dirección de arte y fotografía para que todo cuente la misma historia.",
        imageServices: "Asesoría de imagen · Fotografía · Retoque",
        philosophyCopy:
          "Me considero una persona noble, no para nada sé un ignorante que aprende y tiene experiencias nuevas, por eso me lleva a adquirir más conocimientos.",
        quote: "“La curiosidad es una disciplina: se practica todos los días.”",
        readBlog: "Leer el blog",
        selectedWork: "Trabajo seleccionado",
        client: "Cliente",
        previous: "Trabajo anterior",
        next: "Trabajo siguiente",
        close: "Cerrar detalle",
        panel: "Una colaboración donde identidad, producto y tecnología se encuentran.",
        viewCase: "Ver caso completo",
        drag: "Arrastra el globo · Clic para abrir",
        ideas: "Más ideas, mejores resultados",
        contact: "¿Hacemos algo",
        contactEm: "chingón?",
        whatsapp: "Hablemos por WhatsApp",
        social: "Redes sociales",
      }
    : {
        home: "Home",
        polymath: "polymath engineer",
        chapters: "Chapters",
        ai: "AI & Software",
        design: "Design",
        philosophy: "Philosophy",
        work: "Work",
        headline: "Artificial Intelligence,",
        headlineEnd: "design and philosophy.",
        generation: "Generation",
        quantum: "Quantum orbital",
        reload: "Reload for another · Click to transform",
        scroll: "Scroll",
        applied: "Applied intelligence",
        ideasHeadline: "Ideas that",
        production: "ship",
        aiCopy:
          "I am a full-stack developer who builds useful, clear and memorable products. I work with AI, software and design so ideas can go further.",
        ready: "Ready",
        console: [
          "✓ from prototype to production",
          "✓ AI models integrated with judgment",
          "✓ fast, accessible and beautiful front-end",
          "✓ maintainable, reviewed and tested code",
        ],
        build: "what shall we build together?",
        designKicker: "Brands and experiences that work",
        branding: "Naming, identity and brand redesign with character.",
        product: "Interfaces and applications where form serves function.",
        image: "Art direction and photography so every piece tells the same story.",
        imageServices: "Image consulting · Photography · Retouching",
        philosophyCopy:
          "I see myself as a humble person—still learning, gathering new experiences and expanding my knowledge.",
        quote: "“Curiosity is a discipline: it is practiced every day.”",
        readBlog: "Read the blog",
        selectedWork: "Selected work",
        client: "Client",
        previous: "Previous work",
        next: "Next work",
        close: "Close details",
        panel: "A collaboration where identity, product and technology meet.",
        viewCase: "View full case",
        drag: "Drag the globe · Click to open",
        ideas: "More ideas, better outcomes",
        contact: "Shall we make",
        contactEm: "something great?",
        whatsapp: "Let’s talk on WhatsApp",
        social: "Social media",
      }
const globeWork = [
  ["Fundación de 10", "Cliente", "2016", "fundacion-de-10.jpg"],
  ["Blue Moon", "Cliente", "2021", "blue-moon.jpg"],
  ["Shellhook", "Cliente", "2021", "shellhook.jpg"],
  ["SVGO", "Cliente", "2021", "svgo.jpg"],
  ["Nútrete con Ciencia", "Cliente", "2021", "nutrete-con-ciencia.jpg"],
  ["Constructora GRAN", "Cliente", "2020", "constructora-gran.jpg"],
  ["Paxut", "Cliente", "2019", "paxut.jpg"],
  ["The Hive Offices", "Cliente", "2019", "the-hive-offices.jpg"],
  ["Inbright", "Cliente", "2018", "inbright.jpg"],
  ["Grupo RESA", "Cliente", "2018", "grupo-resa.jpg"],
  ["Huitzil", "Cliente", "2018", "huitzil-muebles.jpg"],
  ["Alphabook", "Cliente", "2018", "alphabook.jpg"],
  ["Buddies", "Cliente", "2018", "buddies.jpg"],
  ["Akuma Store", "Cliente", "2018", "akuma-store.jpg"],
  ["El Taco Rojo", "Cliente", "2018", "el-taco-rojo.jpg"],
  ["VITEM", "Cliente", "2018", "vitem.jpg"],
  ["Winter Wolves", "Cliente", "2018", "winter-wolves.jpg"],
  ["OCEL Global", "Cliente", "2016", "ocel-global.jpg"],
  ["Anthropos Politeia", "Cliente", "2016", "anthropos-politeia.jpg"],
  ["Red5 Gaming", "Cliente", "2016", "red5-gaming.jpg"],
  ["Havoks Gaming", "Cliente", "2016", "havoks-gaming.jpg"],
  ["IDVA", "Cliente", "2016", "idva.jpg"],
  ["Entelequia", "Cliente", "2016", "entelequia.jpg"],
  ["Caleen E-liquids", "Cliente", "2017", "caleen-e-liquids.jpg"],
].map(([title, _kind, year, image]) => {
  const slug = image.replace(/\.[^.]+$/, "")
  return {
    title,
    kind: copy.client,
    year,
    image: `/img/globe/${image}`,
    href: localizedPath(locale, `/work/${slug}/`),
  }
})
---

<BaseLayout locale={locale} title="Derian André" bodyClass="sintesis-home" showHeader={false}>
  <header class="home-ref-header" data-reveal="rise" data-intro="1" style="position:fixed;z-index:30;top:clamp(.5rem,1.5vw,1rem);right:clamp(.5rem,1.5vw,1rem);left:clamp(.5rem,1.5vw,1rem);display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:1rem;padding:.7rem clamp(.9rem,2vw,1.5rem);color:var(--body-color-high);background:hsl(220 23% 5% / .38) url('/img/noise.png');backdrop-filter:blur(22px) saturate(1.5);-webkit-backdrop-filter:blur(22px) saturate(1.5)">
    <div class="home-ref-header-brand" style="display:flex;min-width:0;align-items:center;gap:1rem">
      <a href={localizedPath(locale, "/")} aria-label="Derian André" style="display:flex;align-items:center;color:var(--body-color-high)"><BrandMark style="display:block;width:24px;height:25px;max-width:none;flex:none" /></a>
      <span style="display:flex;min-width:0;align-items:baseline;gap:.5rem;overflow:hidden;border-left:1px solid hsl(220 30% 90% / .12);padding-left:1rem;color:var(--body-color-low);font-size:.75rem;font-weight:700;letter-spacing:.06em;text-overflow:ellipsis;white-space:nowrap"><i style="font-family:var(--font-serif);font-style:italic;font-weight:400;letter-spacing:0">01</i> {copy.home}</span>
    </div>
    <nav aria-label={locale === "es" ? "Navegación principal" : "Primary navigation"} style="display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:.4rem 1.4rem;font-size:.78rem;font-weight:700;letter-spacing:.06em">
      <a href="#trabajo">{locale === "es" ? "Trabajo" : "Work"}</a>
      <a href={localizedPath(locale, "/projects/")}>{locale === "es" ? "Proyectos" : "Projects"}</a>
      <a href={localizedPath(locale, "/blog/")}>Blog</a>
      <a href={localizedPath(locale, "/about/")}>Ego</a>
      <a href={localizedPath(locale, "/services/")}>{locale === "es" ? "Servicios" : "Services"}</a>
      <a href={localizedPath(locale, "/curriculum/")}>CV</a>
      <a class="home-ref-header-language" href={localizedPath(locale === "es" ? "en" : "es", "/")} lang={locale === "es" ? "en" : "es"}>{locale === "es" ? "EN" : "ES"}</a>
    </nav>
  </header>
  <main id="main-content" class="sintesis-home-ref">
    <canvas class="home-ref-background" data-sintesis-background aria-hidden="true"></canvas>

    <section id="inicio" class="home-ref-hero" data-bg="0" data-particle="cloud">
      <canvas class="home-ref-monolith" data-sintesis-monolith aria-hidden="true"></canvas>
      <button class="home-ref-burst" type="button" data-sintesis-burst aria-label="Transformar el monograma"></button>

      <div class="home-ref-hero-top" data-reveal="rise" data-intro="1">
        <div class="home-ref-identity">
          <span>Derian André</span>
          <em>{copy.polymath}</em>
        </div>
        <nav class="home-ref-chapters" aria-label={copy.chapters}>
          <a href="#cap-ia"><i>01</i> {copy.ai}</a>
          <a href="#cap-diseno"><i>02</i> {copy.design}</a>
          <a href="#cap-filosofia"><i>03</i> {copy.philosophy}</a>
          <a href="#trabajo"><i>04</i> {copy.work}</a>
        </nav>
      </div>

      <div></div>

      <div class="home-ref-hero-end">
        <h1>
          <span data-reveal="mask" data-intro="1" data-delay="120">{copy.headline}</span>
          <span data-reveal="mask" data-intro="1" data-delay="260">Software</span>
          <em data-reveal="mask" data-intro="1" data-delay="420">{copy.headlineEnd}</em>
        </h1>
        <div class="home-ref-hero-meta" data-reveal="wipe" data-intro="1" data-delay="700">
          <span><i data-home-generation>{copy.generation} 01 / 05 — {copy.quantum}</i> · {copy.reload}</span>
          <a href="#cap-ia">{copy.scroll} <b>↓</b></a>
        </div>
      </div>
    </section>

    <div class="home-ref-chapter-area">
      <div class="home-ref-field"><canvas data-sintesis-field aria-hidden="true"></canvas></div>

      <section id="cap-ia" class="home-ref-section home-ref-ai" data-bg="1" data-particle="ai">
        <div class="home-ref-ai-stack">
          <p class="home-ref-number" data-reveal="wipe"><i>01</i> <span>{copy.applied}</span></p>
          <h2 data-reveal="mask" data-delay="120">{copy.ideasHeadline}<br />{copy.production} <em>{locale === "es" ? "a producción." : "to production."}</em></h2>
          <p class="home-ref-ai-copy" data-reveal="rise" data-delay="180">{copy.aiCopy}</p>
        </div>
        <div class="home-ref-console" data-reveal="rise" data-delay="200">
            <header><i>derian ~ {locale === "es" ? "taller" : "workshop"}</i><span>{copy.ready}</span></header>
            <pre><span>&gt; {locale === "es" ? "construir(producto" : "build(product"}, &#123; ai: true &#125;)</span>{copy.console.map((line) => <span> {line}</span>)}<strong>&gt; {copy.build}</strong></pre>
        </div>
      </section>

      <section id="cap-diseno" class="home-ref-section home-ref-design" data-bg="2" data-particle="design">
        <p class="home-ref-number" data-reveal="rise"><i>02</i> <span>{copy.designKicker}</span></p>
        <h2 data-reveal="wipe" data-delay="100" data-sintesis-design>{copy.design}</h2>
        <div class="home-ref-design-columns" data-reveal="stagger" data-delay="250">
          <article><h3>Branding</h3><p>{copy.branding}</p><span>Naming · {locale === "es" ? "Identidad · Rediseño · Papelería" : "Identity · Redesign · Stationery"}</span></article>
          <article><h3>{locale === "es" ? "Producto" : "Product"}</h3><p>{copy.product}</p><span>UI · UX · Apps · Web</span></article>
          <article><h3>{locale === "es" ? "Imagen" : "Image"}</h3><p>{copy.image}</p><span>{copy.imageServices}</span></article>
        </div>
      </section>

      <section id="cap-filosofia" class="home-ref-section home-ref-philosophy" data-bg="3" data-particle="philo">
        <div class="home-ref-philosophy-copy" data-reveal="rise">
          <p class="home-ref-number"><i>03</i> <span>{copy.philosophy}</span></p>
          <h2>{locale === "es" ? "Crear es" : "Creating is"}<br />{locale === "es" ? "una forma" : "a way"}<br /><em>{locale === "es" ? "de pensar." : "of thinking."}</em></h2>
          <p>{copy.philosophyCopy}</p>
        </div>
        <div class="home-ref-philosophy-stack">
          <p class="home-ref-philosophy-quote" aria-live="polite">{copy.quote}</p>
          <ol class="home-ref-essays" data-reveal="stagger" data-delay="200">
            {essays.map(({ entry, identity }) => identity && (
              <li>
                <a href={localizedPath(locale, `/blog/${identity.slug}/`)}>
                  <strong>{entry.data.title}</strong>
                  <time>{new Intl.DateTimeFormat(locale === "es" ? "es-MX" : "en-US", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(entry.data.date)}</time>
                </a>
              </li>
            ))}
          </ol>
          <a class="home-ref-outline-button" data-reveal="rise" data-delay="400" href={localizedPath(locale, "/blog/")}>{copy.readBlog}</a>
        </div>
      </section>
    </div>

    <section id="trabajo" class="home-ref-work" data-bg="4">
      <div class="home-ref-work-sticky">
        <canvas data-sintesis-globe aria-label={locale === "es" ? "Globo interactivo de trabajos seleccionados" : "Interactive globe of selected work"} style="touch-action:pan-y"></canvas>
        <p class="home-ref-work-heading" data-reveal="wipe"><i>04</i> <span>{copy.selectedWork}</span></p>
        <div class="home-ref-work-caption" aria-live="polite">
          <i data-globe-index>01 / 24</i><h2 data-globe-title>Blue Moon</h2><span data-globe-meta>Cliente · 2021</span>
        </div>
        <div class="home-ref-work-controls" data-reveal="rise" data-delay="200">
          <div><button type="button" data-globe-prev aria-label={copy.previous}>←</button><button type="button" data-globe-next aria-label={copy.next}>→</button></div>
          <span>{copy.drag}</span>
        </div>
        <aside class="home-ref-work-panel" data-globe-panel hidden>
          <button type="button" data-globe-close aria-label={copy.close}>×</button>
          <i data-panel-index></i><h3 data-panel-title></h3>
          <p>{copy.panel}</p>
          <a data-globe-case-link href={globeWork[0].href}>{copy.viewCase}</a>
        </aside>
      </div>
    </section>

    <section class="home-ref-contact" data-bg="5">
      <div class="home-ref-marquee" data-reveal="blur" aria-hidden="true">
        <div>{locale === "es" ? "Inteligencia Artificial" : "Artificial Intelligence"} <em>{locale === "es" ? "y" : "and"}</em> Software · {copy.design} <em>{locale === "es" ? "y" : "and"}</em> {copy.philosophy} · {locale === "es" ? "Inteligencia Artificial" : "Artificial Intelligence"} <em>{locale === "es" ? "y" : "and"}</em> Software ·</div>
        <div>{locale === "es" ? "Inteligencia Artificial" : "Artificial Intelligence"} <em>{locale === "es" ? "y" : "and"}</em> Software · {copy.design} <em>{locale === "es" ? "y" : "and"}</em> {copy.philosophy} · {locale === "es" ? "Inteligencia Artificial" : "Artificial Intelligence"} <em>{locale === "es" ? "y" : "and"}</em> Software ·</div>
      </div>
      <div class="home-ref-contact-content">
        <p class="home-ref-contact-kicker" data-reveal="wipe"><span><i>05</i> {copy.ideas}</span><span><b></b><time data-home-clock></time></span></p>
        <h2><span>{copy.contact}</span> <em>{copy.contactEm}</em></h2>
        <div class="home-ref-contact-actions" data-reveal="rise" data-delay="450">
          <a class="home-ref-whatsapp" href={`https://wa.me/523312781411?text=${encodeURIComponent(locale === "es" ? "¡Hola, me contacto desde tu portafolio!" : "Hello, I am contacting you from your portfolio!")}`}>{copy.whatsapp} <b>↗</b></a>
          <a class="home-ref-email" href="mailto:hola@derianandre.com">hola@derianandre.com <b>→</b></a>
        </div>
      </div>
      <footer class="home-ref-footer" data-reveal="rise" data-delay="550">
        <nav aria-label={copy.social}><a href="https://facebook.com/DerianAndre">Facebook ↗</a><a href="https://instagram.com/DerianAndre">Instagram ↗</a><a href="https://linkedin.com/in/DerianAndre">LinkedIn ↗</a><a href="https://github.com/DerianAndre">GitHub ↗</a><a href="https://wa.me/523312781411">WhatsApp ↗</a></nav>
        <span>© 2026 Derian André Castillo Franco</span>
      </footer>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .sintesis-home .site-layout{min-height:100vh}.sintesis-home .skip-link{z-index:50}.home-ref-header{position:fixed;z-index:30;top:clamp(.5rem,1.5vw,1rem);right:clamp(.5rem,1.5vw,1rem);left:clamp(.5rem,1.5vw,1rem);display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:1rem;padding:.7rem clamp(.9rem,2vw,1.5rem);color:var(--body-color-high);background:hsl(220 23% 5% / .38) url('/img/noise.png');backdrop-filter:blur(22px) saturate(1.5);-webkit-backdrop-filter:blur(22px) saturate(1.5)}.home-ref-header-brand{display:flex;min-width:0;align-items:center;gap:1rem}.home-ref-header-brand>a{display:flex;align-items:center;color:var(--body-color-high)}.home-ref-header-brand svg{width:24px;height:25px}.home-ref-header-brand>span{display:flex;min-width:0;align-items:baseline;gap:.5rem;overflow:hidden;border-left:1px solid hsl(220 30% 90% / .12);padding-left:1rem;color:var(--body-color-low);font-size:.75rem;font-weight:700;letter-spacing:.06em;text-overflow:ellipsis;white-space:nowrap}.home-ref-header-brand i{font-family:var(--font-serif);font-style:italic;font-weight:400;letter-spacing:0}.home-ref-header nav{display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:.4rem 1.4rem;font-size:.78rem;font-weight:700;letter-spacing:.06em}.home-ref-header nav a{color:var(--body-color-high);text-decoration:none;transition:color 200ms ease}.home-ref-header nav a:hover{color:var(--body-color-normal)}.home-ref-header .home-ref-header-language{color:var(--body-color-low)}
  .sintesis-home-ref{position:relative;min-height:100vh;isolation:isolate;overflow:clip;color:var(--body-color-normal);font-family:var(--font-heading)}
  .home-ref-background{position:fixed;inset:0;z-index:-2;display:block;width:100vw;height:100vh}.home-ref-hero{position:relative;z-index:1;isolation:isolate;display:grid;min-height:max(100vh,32rem);grid-template-rows:auto minmax(0,1fr) auto;padding:clamp(5.5rem,9vw,7rem) clamp(1.25rem,3.5vw,3rem) clamp(1.25rem,3vw,2.25rem);touch-action:pan-y}.home-ref-monolith{position:absolute;inset:0;z-index:-1;display:block;width:100%;height:100%;pointer-events:none}.home-ref-burst{position:absolute;z-index:1;top:50%;left:50%;width:min(28vw,24rem);height:min(45vw,34rem);border:0;background:transparent;cursor:pointer;transform:translate(-50%,-50%)}
