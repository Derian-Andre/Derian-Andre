---
import ResponsiveImage from "@/components/ResponsiveImage.astro"
import { getLocaleStaticPaths } from "@/components/site"
import { getTranslations, type Locale, localizedPath } from "@/i18n"
import SintesisLayout from "@/layouts/SintesisLayout.astro"

export function getStaticPaths() {
  return getLocaleStaticPaths()
}

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const translations = getTranslations(locale)
const about = translations.about
const summaryItems = Object.values(about.summary.list)
---

<SintesisLayout
  locale={locale}
  page="about"
  title={about.title}
  description={translations.head.description}
  image="/img/ego.jpg"
  sceneMode={0}
>
  <section class="sintesis-ego">
    <figure data-reveal="blur">
      <ResponsiveImage src="/img/ego.jpg" alt="Derian André Castillo Franco" loading="eager" fetchpriority="high" />
      <figcaption>Ego sum.</figcaption>
    </figure>
    <div class="sintesis-ego__content">
      <span data-reveal="wipe">{about.subtitle}</span>
      <h1 data-reveal="mask" data-delay="100">{about.title}</h1>
      <div class="sintesis-prose" data-reveal="stagger" data-delay="200">
        <p class="lead" set:html={about.lead}></p>
        <p set:html={about.where}></p>
        <p set:html={about.summary.content}></p>
      </div>
      <ol class="sintesis-ego__roles" data-reveal="stagger" data-delay="300">
        {summaryItems.map((item) => <li set:html={item}></li>)}
      </ol>
      <section class="sintesis-glass-card" data-reveal="rise">
        <h2>{about.more.title}</h2>
        <p>{about.more.content}</p>
        <div class="sintesis-actions">
          <a class="sintesis-button sintesis-button--solid" href={localizedPath(locale, "/curriculum/")}>{translations.curriculum.title}</a>
          <a class="sintesis-button" href={localizedPath(locale, "/projects/")}>{translations.projects.title}</a>
          <a class="sintesis-button" href="https://github.com/Derian-Andre/Derian-Andre">GitHub ↗</a>
        </div>
      </section>
    </div>
  </section>
</SintesisLayout>
