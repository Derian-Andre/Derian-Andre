---
import ResponsiveImage from "@/components/ResponsiveImage.astro"
import { getLocaleStaticPaths } from "@/components/site"
import { getTranslations, type Locale, localizedPath } from "@/i18n"
import PageLayout from "@/layouts/PageLayout.astro"

export function getStaticPaths() {
  return getLocaleStaticPaths()
}

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const translations = getTranslations(locale)
const about = translations.about
const summaryItems = Object.values(about.summary.list)
---

<PageLayout
  locale={locale}
  page="about"
  title={about.title}
  subtitle={about.subtitle}
  description={translations.head.description}
  image="/img/ego.jpg"
  contentClass="content-about"
  showFooter
>
  <p class="eyebrow">Ego sum,</p>
  <h2>Derian André Castillo Franco</h2>
  <p class="lead" set:html={about.lead}></p>
  <p set:html={about.where}></p>
  <hr />
  <h2>{about.summary.title}</h2>
  <p set:html={about.summary.content}></p>
  <ul>
    {summaryItems.map((item) => <li set:html={item}></li>)}
  </ul>
  <hr />
  <h2>{about.more.title}</h2>
  <p>{about.more.content}</p>
  <div class="button-row">
    <a class="button" href={localizedPath(locale, "/curriculum/")}>{translations.curriculum.title}</a>
    <a class="button" href={localizedPath(locale, "/projects/")}>{translations.projects.title}</a>
    <a class="button" href="https://github.com/Derian-Andre/Derian-Andre">GitHub</a>
  </div>

  <section slot="side" class="page-side">
    <ResponsiveImage src="/img/ego.jpg" alt="Derian André Castillo Franco" loading="eager" fetchpriority="high" />
  </section>
</PageLayout>
