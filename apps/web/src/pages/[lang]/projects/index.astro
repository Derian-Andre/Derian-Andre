---
import { getCollection } from "astro:content"
import ProjectCard from "@/components/ProjectCard.astro"
import { getLocaleStaticPaths, isPublished, splitEntryId } from "@/components/site"
import { getTranslations, type Locale } from "@/i18n"
import PageLayout from "@/layouts/PageLayout.astro"

export function getStaticPaths() {
  return getLocaleStaticPaths()
}

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const translations = getTranslations(locale)
const entries = await getCollection("projects")
const projects = entries
  .map((entry) => ({ entry, identity: splitEntryId(entry.id) }))
  .filter(({ entry, identity }) => identity?.locale === locale && isPublished(entry.data))
  .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf())
---

<PageLayout
  locale={locale}
  page="projects"
  title={translations.projects.title}
  subtitle={translations.projects.subtitle}
  description={translations.head.description}
  contentClass="content-projects"
>
  <div class="projects-grid">
    {
      projects.map(({ entry, identity }) =>
        identity ? (
          <ProjectCard
            locale={locale}
            slug={identity.slug}
            title={entry.data.title}
            description={entry.data.description}
            date={entry.data.date}
            hero={entry.data.hero}
            cta={translations.projects.learn_more}
          />
        ) : null,
      )
    }
  </div>
</PageLayout>
