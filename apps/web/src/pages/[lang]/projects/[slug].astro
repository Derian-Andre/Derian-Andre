---
import { type CollectionEntry, getCollection, render } from "astro:content"
import LegacyContent from "@/components/LegacyContent.astro"
import ResponsiveImage from "@/components/ResponsiveImage.astro"
import { isPublished, splitEntryId } from "@/components/site"
import { getTranslations, type Locale } from "@/i18n"
import PageLayout from "@/layouts/PageLayout.astro"

export async function getStaticPaths() {
  const entries = await getCollection("projects")

  return entries.flatMap((entry) => {
    const identity = splitEntryId(entry.id)
    if (!identity || !isPublished(entry.data)) return []

    return [
      { params: { lang: identity.locale, slug: identity.slug }, props: { entry, ...identity } },
    ]
  })
}

interface Props {
  entry: CollectionEntry<"projects">
  locale: Locale
  slug: string
}

const { entry, locale, slug } = Astro.props
const translations = getTranslations(locale)
const { Content } = await render(entry)
const image = entry.data.hero ? `/img/projects/${slug}/${entry.data.hero}` : undefined
---

<PageLayout
  locale={locale}
  page="projects"
  title={entry.data.title}
  subtitle={entry.data.subtitle}
  description={entry.data.description ?? translations.head.description}
  image={image}
  type="article"
  publishedTime={entry.data.date}
>
  <time class="content-date" datetime={entry.data.date.toISOString()}>
    {new Intl.DateTimeFormat(locale === "es" ? "es-MX" : "en-US", { dateStyle: "long", timeZone: "UTC" }).format(entry.data.date)}
  </time>
  <LegacyContent class="article">
    <Content />
  </LegacyContent>
  <hr />
  <h2>{translations.projects.sponsor.title}</h2>
  <p>{translations.projects.sponsor.description}</p>
  <div class="button-row">
    <a class="button" target="_blank" rel="noreferrer nofollow noopener" href="https://github.com/sponsors/derianandre">
      {translations.projects.sponsor.github}
    </a>
    <a class="button" target="_blank" rel="noreferrer nofollow noopener" href="https://paypal.me/DerianAndre">
      {translations.projects.sponsor.paypal}
    </a>
  </div>

  {
    image && (
      <section slot="side" class="page-side">
        <ResponsiveImage src={image} alt={entry.data.title} loading="eager" fetchpriority="high" />
      </section>
    )
  }
</PageLayout>
