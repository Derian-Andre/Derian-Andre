---
import { type CollectionEntry, getCollection, render } from "astro:content"
import LegacyContent from "@/components/LegacyContent.astro"
import { isPublished, splitEntryId } from "@/components/site"
import { getTranslations, type Locale, localizedPath } from "@/i18n"
import SintesisLayout from "@/layouts/SintesisLayout.astro"

export async function getStaticPaths() {
  const entries = await getCollection("projects")

  return entries.flatMap((entry) => {
    const identity = splitEntryId(entry.id)
    if (!identity || !isPublished(entry.data)) return []

    return [
      { params: { lang: identity.locale, slug: identity.slug }, props: { entry, ...identity } },
    ]
  })
}

interface Props {
  entry: CollectionEntry<"projects">
  locale: Locale
  slug: string
}

const { entry, locale, slug } = Astro.props
const translations = getTranslations(locale)
const { Content } = await render(entry)
const image = entry.data.hero
  ? slug === "orca-tools"
    ? `/img/projects/${slug}/${entry.data.hero}`
    : `/img/projects/${entry.data.hero}`
  : undefined
---

<SintesisLayout
  locale={locale}
  page="projects"
  title={entry.data.title}
  description={entry.data.description ?? translations.head.description}
  image={image}
  type="article"
  publishedTime={entry.data.date}
  sceneMode={5}
>
  <article class="sintesis-project-detail">
    <header>
      {image && <img data-reveal="blur" src={image} alt={entry.data.title} />}
      <div>
        <a data-reveal="wipe" href={localizedPath(locale, "/projects/")}>← {locale === "es" ? "Todos los proyectos" : "All projects"}</a>
        <time data-reveal="wipe" data-delay="80" datetime={entry.data.date.toISOString()}>{new Intl.DateTimeFormat(locale === "es" ? "es-MX" : "en-US", { dateStyle: "long", timeZone: "UTC" }).format(entry.data.date)}</time>
        <h1 data-reveal="mask" data-delay="150">{entry.data.title}</h1>
        {entry.data.subtitle && <p>{entry.data.subtitle}</p>}
      </div>
    </header>
    <section class="sintesis-project-detail__content" data-reveal="stagger">
      <LegacyContent class="sintesis-prose"><Content /></LegacyContent>
    </section>
    <aside class="sintesis-glass-card sintesis-project-detail__support" data-reveal="rise">
      <h2>{translations.projects.sponsor.title}</h2>
      <p>{translations.projects.sponsor.description}</p>
      <div class="sintesis-actions">
        <a class="sintesis-button" target="_blank" rel="noreferrer nofollow noopener" href="https://github.com/sponsors/derianandre">{translations.projects.sponsor.github}</a>
        <a class="sintesis-button" target="_blank" rel="noreferrer nofollow noopener" href="https://paypal.me/DerianAndre">{translations.projects.sponsor.paypal}</a>
      </div>
    </aside>
  </article>
</SintesisLayout>
