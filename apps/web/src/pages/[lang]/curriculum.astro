---
import Curriculum from "@/components/curriculum/Curriculum.astro"
import { getTranslations, isLocale, type Locale, locales } from "@/i18n"
import SintesisLayout from "@/layouts/SintesisLayout.astro"

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }))
}

const rawLocale = Astro.params.lang ?? "es"
if (!isLocale(rawLocale)) {
  return Astro.redirect("/es/curriculum", 302)
}

const locale: Locale = rawLocale
const translations = getTranslations(locale)
const title = translations.curriculum.title
const description = translations.curriculum.about.lead
---

<SintesisLayout {locale} page="curriculum" {title} {description} sceneMode={4}>
	<Curriculum {locale} />
</SintesisLayout>

<style is:global>
	@media (min-width: 75rem) {
		.sintesis-curriculum__page .cv-page {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 32.5rem 15rem;
			column-gap: 2rem;
			align-items: start;
		}

		.sintesis-curriculum__page .cv-title-rail {
			grid-column: 1;
			grid-row: 1;
			margin: 0;
		}

		.sintesis-curriculum__page .cv-content,
		.sintesis-curriculum__page .cv-columns {
			display: contents;
		}

		.sintesis-curriculum__page .cv-experience {
			grid-column: 2;
			grid-row: 1;
			order: initial;
			min-width: 0;
			margin-top: -2.5rem;
		}

		.sintesis-curriculum__page .cv-about {
			grid-column: 3;
			grid-row: 1;
			position: sticky;
			top: 5rem;
			order: initial;
			min-width: 0;
			margin-top: -2.5rem;
			padding: 0;
			gap: .65rem;
			border: 0;
			background: transparent;
		}

		.sintesis-curriculum__page .cv-experience > h2 {
			font-size: 3.5rem;
		}

		.sintesis-curriculum__page .cv-intro {
			font-size: .85rem;
			line-height: 1.45;
		}

		.sintesis-curriculum__page .cv-actions {
			margin-top: .65rem;
			gap: .35rem;
		}

		.sintesis-curriculum__page .cv-action {
			min-height: 1.55rem;
			padding: .2rem .55rem;
			font-size: .55rem;
		}

		.sintesis-curriculum__page .cv-page hr {
			margin: .9rem 0;
		}

		.sintesis-curriculum__page .cv-experience-columns {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.6rem;
		}

		.sintesis-curriculum__page .cv-experience h3 {
			margin-bottom: .65rem;
			font-size: 1.25rem;
		}

		.sintesis-curriculum__page .cv-entry {
			padding: 1rem 0 1.25rem;
			gap: .55rem;
		}

		.sintesis-curriculum__page .cv-entry-logo {
			width: min(8rem, 100%);
			height: 2.4rem;
		}

		.sintesis-curriculum__page .cv-provider-logo {
			width: 6.5rem;
			height: 2rem;
		}

