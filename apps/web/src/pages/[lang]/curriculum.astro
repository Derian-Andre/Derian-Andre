---
import Curriculum from "@/components/curriculum/Curriculum.astro"
import { getTranslations, isLocale, type Locale, locales } from "@/i18n"
import SintesisLayout from "@/layouts/SintesisLayout.astro"

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }))
}

const rawLocale = Astro.params.lang ?? "es"
if (!isLocale(rawLocale)) {
  return Astro.redirect("/es/curriculum", 302)
}

const locale: Locale = rawLocale
const translations = getTranslations(locale)
const title = `${translations.curriculum.title} | Senior AI Fullstack Engineer`
const description = translations.curriculum.about.lead
---

<SintesisLayout {locale} page="curriculum" {title} {description} sceneMode={4}>
	<Curriculum {locale} />
</SintesisLayout>

<style is:global>
	/* The CV has its own editorial layout. Keep one surface recipe for cards and
	 * move the padding to the sidebar sections instead of their empty wrapper. */
	body.sintesis-curriculum .sintesis-curriculum__page .cv-page {
		display: block;
		min-height: 100vh;
		padding: clamp(5.5rem, 8vw, 8rem) clamp(1.25rem, 3.5vw, 3rem) clamp(3rem, 6vw, 5rem);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-title-rail {
		position: static;
		display: block;
		min-height: auto;
		padding: 0;
		border: 0;
		writing-mode: initial;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-title-rail > span {
		display: block;
		margin-bottom: 0.8rem;
		color: var(--body-color-low);
		font: 800 0.75rem var(--font-heading);
		letter-spacing: 0.07em;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-title-rail h1,
	body.sintesis-curriculum .sintesis-curriculum__page .cv-title-rail p {
		transform: none;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-title-rail h1 {
		max-width: 18ch;
		margin: 0;
		color: var(--body-color-high);
		font: 900 clamp(3.25rem, 7.2vw, 7.75rem) / 0.86 var(--font-heading);
		letter-spacing: -0.06em;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-title-rail h1 em {
		color: rgb(210 214 224);
		font: italic 400 0.88em / 1 "Instrument Serif", var(--font-serif);
		letter-spacing: -0.06em;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-title-rail p {
		max-width: 55rem;
		margin: 0.7rem 0 0;
		color: var(--body-color-medium);
		font: 600 clamp(1rem, 1.35vw, 1.35rem) / 1.35 var(--font-serif);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-content {
		max-width: none;
		padding: clamp(2.5rem, 5vw, 4.5rem) 0 0;
		overflow: visible;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-columns {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: clamp(2rem, 4vw, 4rem);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-experience {
		order: 1;
		flex: 3 1 34rem;
		min-width: 0;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-about {
		position: static;
		order: 2;
		display: grid;
		flex: 1 1 18rem;
		gap: 0.75rem;
		min-width: min(100%, 18rem);
		padding: 0;
		border: 0;
		background: transparent;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-about section,
	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-card {
		box-sizing: border-box;
		border: 1px solid hsl(220 30% 90% / 0.12);
		background: hsl(220 23% 5% / 0.42) url("/img/noise.png");
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-about section {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.1rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-about hr {
		display: none;
	}

	body.sintesis-curriculum .sintesis-curriculum__page :is(.cv-about h2, .cv-about h3) {
		margin: 0;
		color: var(--body-color-low);
		font: 800 0.72rem var(--font-heading);
		letter-spacing: 0.07em;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-about h4 {
		margin: 0;
		color: var(--body-color-high);
		font: 800 0.9rem var(--font-heading);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-about h4 small {
		font-size: 0.55rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-contact-list {
		gap: 0.55rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-contact-list li {
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-contact-list a {
		display: block;
		color: var(--body-color-medium);
		font: 700 0.8rem / 1.25 var(--font-heading);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-contact-list span {
		display: grid;
		width: 1.55rem;
		height: 1.55rem;
		place-items: center;
		border: 1px solid hsl(220 30% 90% / 0.16);
		color: var(--body-color-high);
		font: 800 0.6rem var(--font-heading);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-contact-list .cv-contact-icon--social .social-icon {
		width: 0.72rem;
		height: 0.72rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-skill-group + .cv-skill-group {
		margin-top: 0.7rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-skill-icons {
		gap: 0.3rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-icon-tooltip {
		position: relative;
		display: inline-grid;
		width: 1.2rem;
		height: 1.2rem;
		place-items: center;
		cursor: help;
		outline: none;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-icon-tooltip::after {
		position: absolute;
		z-index: 20;
		bottom: calc(100% + 0.45rem);
		left: 50%;
		width: max-content;
		max-width: min(15rem, calc(100vw - 2rem));
		padding: 0.38rem 0.5rem;
		border: 1px solid hsl(220 30% 90% / 0.28);
		background: hsl(224 26% 6% / 0.96);
		box-shadow: 0 0.45rem 1.2rem hsl(228 42% 2% / 0.45);
		color: var(--body-color-high);
		content: attr(data-tooltip);
		font: 700 0.62rem / 1.2 var(--font-heading);
		letter-spacing: 0.01em;
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, 0.2rem);
		transition: opacity 140ms ease, transform 140ms ease;
		visibility: hidden;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-icon-tooltip:hover::after,
	body.sintesis-curriculum .sintesis-curriculum__page .cv-icon-tooltip:focus-visible::after,
	body.sintesis-curriculum .sintesis-curriculum__page .cv-icon-tooltip:active::after {
		opacity: 1;
		transform: translate(-50%, 0);
		visibility: visible;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-icon-tooltip:focus-visible {
		border-radius: 0.12rem;
		box-shadow: 0 0 0 2px hsl(220 30% 90% / 0.56);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-skill-icons img {
		width: 1.2rem;
		height: 1.2rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-experience > h2 {
		margin: 0;
		color: var(--body-color-high);
		font: italic 400 clamp(3rem, 5vw, 5rem) / 0.9 "Instrument Serif", var(--font-serif);
		letter-spacing: -0.045em;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-intro {
		max-width: 58ch;
		margin-top: 1rem;
		color: var(--body-color-medium);
		font: clamp(1rem, 1.3vw, 1.2rem) / 1.6 var(--font-serif);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-actions {
		margin-top: 1.25rem;
		gap: 0.6rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-action {
		min-height: 2.25rem;
		padding: 0.4rem 0.8rem;
		border-color: hsl(220 30% 90% / 0.32);
		font-size: 0.65rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-page hr {
		margin: 2rem 0;
		border-color: hsl(220 30% 90% / 0.12);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-experience-content {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4.5rem);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-experience-section,
	body.sintesis-curriculum .sintesis-curriculum__page .cv-credentials {
		min-width: 0;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-experience h3 {
		margin: 0 0 1.25rem;
		color: var(--body-color-high);
		font: 900 clamp(1.75rem, 2.6vw, 2.7rem) / 0.95 var(--font-heading);
		letter-spacing: -0.045em;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-entry {
		display: flex;
		padding: 2rem 0;
		flex-direction: column;
		gap: 0.85rem;
		border-top: 1px solid hsl(220 30% 90% / 0.12);
		border-bottom: 0;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-entry-logo {
		width: min(13rem, 100%);
		height: 3.6rem;
		margin: 0;
		opacity: 1;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-entry h4 {
		margin: 0;
		color: var(--body-color-high);
		font: 900 clamp(1.2rem, 1.8vw, 1.6rem) / 1.1 var(--font-heading);
		letter-spacing: -0.03em;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-entry h5 {
		margin: 0;
		color: var(--body-color-medium);
		font: 700 0.9rem var(--font-heading);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-entry h6 {
		margin: 0;
		color: var(--body-color-low);
		font: italic 0.85rem var(--font-serif);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-entry-description {
		color: var(--body-color-normal);
		font: 1rem / 1.65 var(--font-serif);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-entry-stack {
		gap: 0.35rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-entry-stack img {
		width: 1rem;
		height: 1rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-provider + .cv-provider {
		margin-top: 2.5rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-provider-logo {
		width: auto;
		max-width: min(13rem, 100%);
		height: 3.25rem;
		margin: 0 0 1rem;
		opacity: 1;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-provider-heading {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin-bottom: 1rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-provider-heading .cv-provider-logo {
		margin: 0;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-provider-title {
		margin: 0;
		color: var(--body-color-high);
		font: 900 clamp(1.25rem, 2vw, 1.7rem) / 1 var(--font-heading);
		letter-spacing: -0.035em;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 0.75rem;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-card {
		display: flex;
		min-height: 0;
		padding: 1.1rem;
		flex-direction: column;
		align-items: flex-start;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-heading {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		gap: 0.5rem;
		width: 100%;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-mark {
		width: 1.05rem;
		height: 1.05rem;
		margin-top: 0.1rem;
		object-fit: contain;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-mark--provider {
		width: 2.35rem;
		height: 1.25rem;
		object-position: left center;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-card h5 {
		margin: 0;
		color: var(--body-color-high);
		font: 800 0.85rem / 1.2 var(--font-heading);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-card h5 a {
		color: inherit;
		text-decoration-color: hsl(220 30% 90% / 0.35);
		text-underline-offset: 0.18em;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-card h6 {
		margin: 0.7rem 0 0;
		color: var(--body-color-low);
		font: italic 0.72rem var(--font-serif);
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-id {
		margin: 0.85rem 0 0;
		color: var(--body-color-low);
		font: 0.6rem / 1.35 var(--font-heading);
		word-break: break-all;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-id span {
		font-weight: 800;
	}

	body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-id code {
		color: var(--body-color-muted);
		font: inherit;
	}

	@media (min-width: 75rem) {
		body.sintesis-curriculum .sintesis-curriculum__page .cv-page {
			display: grid;
			grid-template-columns: minmax(0, 1fr) clamp(17rem, 28vw, 32rem);
			column-gap: clamp(1.5rem, 3vw, 3rem);
			align-items: start;
		}

		body.sintesis-curriculum .sintesis-curriculum__page .cv-title-rail {
			grid-column: 1 / -1;
			grid-row: 1;
		}

		body.sintesis-curriculum .sintesis-curriculum__page :is(.cv-content, .cv-columns) {
			display: contents;
		}

		body.sintesis-curriculum .sintesis-curriculum__page .cv-experience {
			grid-column: 1;
			grid-row: 2;
			order: initial;
		}

		body.sintesis-curriculum .sintesis-curriculum__page .cv-about {
			position: sticky;
			top: 5rem;
			grid-column: 2;
			grid-row: 2;
			order: initial;
		}
	}

	@media (min-width: 95rem) {
		body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (max-width: 40rem) {
		body.sintesis-curriculum .sintesis-curriculum__page .cv-title-rail h1 {
			font-size: clamp(2.8rem, 15vw, 4.5rem);
		}

		body.sintesis-curriculum .sintesis-curriculum__page .cv-about {
			min-width: 0;
		}

		body.sintesis-curriculum .sintesis-curriculum__page .cv-credential-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
