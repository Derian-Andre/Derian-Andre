---
import { type CollectionEntry, getCollection, render } from "astro:content"
import LegacyContent from "@/components/LegacyContent.astro"
import { isPublished, splitEntryId } from "@/components/site"
import { getTranslations, type Locale, localizedPath } from "@/i18n"
import SintesisLayout from "@/layouts/SintesisLayout.astro"

export async function getStaticPaths() {
  const entries = await getCollection("work")

  return entries.flatMap((entry) => {
    const identity = splitEntryId(entry.id)
    if (!identity || !isPublished(entry.data)) return []

    return [
      { params: { lang: identity.locale, slug: identity.slug }, props: { entry, ...identity } },
    ]
  })
}

interface Props {
  entry: CollectionEntry<"work">
  locale: Locale
  slug: string
}

const { entry, locale, slug } = Astro.props
const translations = getTranslations(locale)
const { Content } = await render(entry)
const hero = entry.data.hero ?? `${slug}.png`
const heroPath = `/img/work/${slug}/${hero}`
const caseHero = slug === "paxut" ? "/img/case/paxut-1.jpg" : heroPath
const caseImage = slug === "paxut" ? "/img/case/paxut-2.jpg" : heroPath
const workEntries = (await getCollection("work"))
  .map((workEntry) => ({ entry: workEntry, identity: splitEntryId(workEntry.id) }))
  .filter(({ entry: workEntry, identity }) => identity?.locale === locale && isPublished(workEntry.data))
  .sort((a, b) => a.entry.data.date.valueOf() - b.entry.data.date.valueOf())
const workIndex = workEntries.findIndex(({ identity }) => identity?.slug === slug)
const nextWork = workIndex >= 0 ? workEntries[(workIndex + 1) % workEntries.length] : undefined
---

<SintesisLayout
  locale={locale}
  page="work"
  title={entry.data.title}
  description={entry.data.description ?? translations.head.description}
  image={caseHero}
  type="article"
  publishedTime={entry.data.date}
  sceneMode={6}
  noindex={entry.data.draft}
>
  {
    entry.data.draft ? (
      <section class="sintesis-case sintesis-case--notice">
        <h1>{translations.page.construction.title}</h1>
        <p>{translations.page.construction.description}</p>
      </section>
    ) : (
      <article class="sintesis-case">
        <section class="sintesis-case__hero">
          <img data-reveal="blur" src={caseHero} alt={entry.data.title} />
          <div aria-hidden="true"></div>
          <div>
            <a data-reveal="wipe" href={localizedPath(locale, "/work/")}>← {locale === "es" ? "Todo el trabajo" : "All work"}</a>
            <h1 data-reveal="mask" data-delay="100">{entry.data.title}</h1>
            {entry.data.subtitle && <p data-reveal="mask" data-delay="250">{entry.data.subtitle}</p>}
          </div>
        </section>

        <section class="sintesis-case__meta" data-reveal="stagger">
          <div><span>{locale === "es" ? "Año" : "Year"}</span><b>{entry.data.date.getUTCFullYear()}</b></div>
          <div><span>{locale === "es" ? "Cliente" : "Client"}</span><b>{entry.data.title}</b></div>
          <div><span>{locale === "es" ? "Trabajo" : "Work"}</span><ul><li>{locale === "es" ? "Identidad" : "Identity"}</li><li>{locale === "es" ? "Diseño" : "Design"}</li><li>{locale === "es" ? "Producto" : "Product"}</li></ul></div>
        </section>

        {!entry.data.working && <aside class="sintesis-case__notice"><h2>{translations.work.not_working.title}</h2><p set:html={translations.work.not_working.description}></p></aside>}
        {entry.data.description && <p class="sintesis-case__lead" data-reveal="rise">{entry.data.description}</p>}
        <figure class="sintesis-case__image"><img data-reveal="wipe" src={caseImage} alt={entry.data.title} /></figure>
        <section class="sintesis-case__body">
          <h2 data-reveal="wipe">{locale === "es" ? "Justificación" : "Rationale"}</h2>
          <div data-reveal="stagger"><LegacyContent class="sintesis-prose"><Content /></LegacyContent></div>
        </section>
        {
          nextWork?.identity && (
            <a class="sintesis-case__next" data-reveal="rise" href={localizedPath(locale, `/work/${nextWork.identity.slug}/`)}>
              <img src={`/img/work/${nextWork.identity.slug}/${nextWork.entry.data.hero ?? `${nextWork.identity.slug}.png`}`} alt="" />
              <div><span>{locale === "es" ? "Siguiente caso" : "Next case"}</span><b>{nextWork.entry.data.title}</b></div>
              <strong aria-hidden="true">→</strong>
            </a>
          )
        }
      </article>
    )
  }
</SintesisLayout>
