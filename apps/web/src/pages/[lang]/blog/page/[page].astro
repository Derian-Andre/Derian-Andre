---
import { getCollection } from "astro:content"
import RedirectPage from "@/components/RedirectPage.astro"
import { isPublished, splitEntryId } from "@/components/site"
import { type Locale, locales, localizedPath } from "@/i18n"
import { BLOG_PAGE_SIZE } from "@/lib/content/constants"

export async function getStaticPaths() {
  const entries = await getCollection("blog")

  return locales.flatMap((locale) => {
    const count = entries.filter(
      (entry) => splitEntryId(entry.id)?.locale === locale && isPublished(entry.data),
    ).length
    const totalPages = Math.max(1, Math.ceil(count / BLOG_PAGE_SIZE))

    return Array.from({ length: totalPages }, (_, index) => ({
      params: { lang: locale, page: String(index + 1) },
      props: { locale },
    }))
  })
}

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<RedirectPage {locale} to={localizedPath(locale, "/blog/")} />
