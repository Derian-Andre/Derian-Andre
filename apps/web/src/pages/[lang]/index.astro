---
import { getCollection } from "astro:content"
import Footer from "@/components/Footer.astro"
import { getLocaleStaticPaths, isPublished, splitEntryId } from "@/components/site"
import WorkCard from "@/components/WorkCard.astro"
import { getTranslations, type Locale } from "@/i18n"
import BaseLayout from "@/layouts/BaseLayout.astro"

export function getStaticPaths() {
  return getLocaleStaticPaths()
}

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const translations = getTranslations(locale)
const entries = await getCollection("work")
const work = entries
  .map((entry) => ({ entry, identity: splitEntryId(entry.id) }))
  .filter(({ entry, identity }) => identity?.locale === locale && isPublished(entry.data))
  .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf())
---

<BaseLayout locale={locale} title={translations.home.title} description={translations.head.description} bodyClass="page page-home">
  <main id="main-content" class="page-main home-gallery">
    <h1 class="sr-only">{translations.home.title}</h1>
    {
      work.map(({ entry, identity }) =>
        identity ? (
          <WorkCard
            locale={locale}
            slug={identity.slug}
            title={entry.data.title}
            date={entry.data.date}
            hero={entry.data.hero}
          />
        ) : null,
      )
    }
    <Footer locale={locale} />
  </main>
</BaseLayout>
