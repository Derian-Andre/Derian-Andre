---
import { getAbsoluteLocaleUrl } from "astro:i18n"
import Header from "@/components/Header.astro"
import {
  defaultLocale,
  getTranslations,
  type Locale,
  localeMetadata,
  locales,
  stripLocalePrefix,
} from "@/i18n"
import "@/styles/global.css"

interface Props {
  locale?: Locale
  title?: string
  description?: string
  image?: string
  type?: "website" | "article"
  publishedTime?: Date | string
  modifiedTime?: Date | string
  noindex?: boolean
  bodyClass?: string
  sceneMode?: number
  showHeader?: boolean
}

const {
  locale = defaultLocale,
  title,
  description = getTranslations(locale).head.description,
  image = "/img/derianandre.png",
  type = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  bodyClass = "",
  sceneMode: requestedSceneMode,
  showHeader = true,
} = Astro.props

const siteName = "Derian André"
const pageTitle = title && title !== siteName ? `${title} – ${siteName}` : siteName
const withoutTrailingSlash = (pathname: string) => pathname.replace(/\/$/, "") || "/"
const canonicalURL = new URL(
  withoutTrailingSlash(Astro.url.pathname),
  Astro.site ?? "https://derianandre.com",
)
const imageURL = new URL(image, canonicalURL)
const pathWithoutLocale = stripLocalePrefix(Astro.url.pathname).replace(/^\/|\/$/g, "")
const alternateURLs = locales.map((alternateLocale) => ({
  locale: alternateLocale,
  url: new URL(
    withoutTrailingSlash(
      new URL(
        pathWithoutLocale
          ? getAbsoluteLocaleUrl(alternateLocale, pathWithoutLocale)
          : getAbsoluteLocaleUrl(alternateLocale),
      ).pathname,
    ),
    Astro.site ?? "https://derianandre.com",
  ),
}))
const localeTag = localeMetadata[locale].openGraphLocale
const alternateLocaleTags = locales
  .filter((alternateLocale) => alternateLocale !== locale)
  .map((alternateLocale) => localeMetadata[alternateLocale].openGraphLocale)

const toIsoDate = (value: Date | string | undefined) => {
  if (!value) return undefined
  const date = new Date(value)
  return Number.isNaN(date.valueOf()) ? undefined : date.toISOString()
}
const usesHomeScenes = bodyClass.includes("sintesis-home")
const sceneByPage: Record<string, number> = {
  "page-work": 6,
  "page-projects": 5,
  "page-blog": 3,
  "page-about": 0,
  "page-services": 1,
  "page-curriculum": 4,
  "page-error": 2,
  "work-index": 4,
}
const sceneMode = requestedSceneMode ?? Object.entries(sceneByPage).find(([className]) => bodyClass.includes(className))?.[1] ?? 6
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0c10" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalURL} />
    {
      alternateURLs.map(({ locale: alternateLocale, url }) => (
        <link rel="alternate" hreflang={alternateLocale} href={url} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternateURLs.find(({ locale }) => locale === "es")?.url} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Lora:ital,wght@0,400..700;1,400..700&family=Montserrat:wght@300..900&display=swap"
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={title ?? siteName} />
    <meta property="og:locale" content={localeTag} />
    {
      alternateLocaleTags.map((alternateLocaleTag) => (
        <meta property="og:locale:alternate" content={alternateLocaleTag} />
      ))
    }
    {type === "article" && toIsoDate(publishedTime) && <meta property="article:published_time" content={toIsoDate(publishedTime)} />}
    {type === "article" && toIsoDate(modifiedTime) && <meta property="article:modified_time" content={toIsoDate(modifiedTime)} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@DerianAndre" />
    <meta name="twitter:creator" content="@DerianAndre" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <title>{pageTitle}</title>
    <slot name="head" />

    <script is:inline>
      document.documentElement.classList.remove("no-js", "light");
      document.documentElement.classList.add("dark");
      document.documentElement.dataset.theme = "dark";
      document.documentElement.style.colorScheme = "dark";
    </script>
    <script is:inline>
      // The previous deployment installed a root-scoped Workbox worker that is no longer served.
      // Remove it once so existing visitors can load the current static site without stale caching.
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker
          .getRegistrations()
          .then(async (registrations) => {
            const legacyRegistrations = registrations.filter((registration) => {
              const worker = registration.active ?? registration.waiting ?? registration.installing
              return worker && new URL(worker.scriptURL).pathname === "/sw.js"
            })

            if (!legacyRegistrations.length) return

            const unregistered = (
              await Promise.all(legacyRegistrations.map((registration) => registration.unregister()))
            ).some(Boolean)

            if (!unregistered) return

            const cacheKeys = await caches.keys()
            await Promise.all(
              cacheKeys
                .filter((cacheKey) => cacheKey.startsWith("workbox"))
                .map((cacheKey) => caches.delete(cacheKey)),
            )
            location.reload()
          })
          .catch(() => undefined)
      }
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{locale === "es" ? "Saltar al contenido" : "Skip to content"}</a>
    <div class="site-layout">
      {!usesHomeScenes && <canvas class="sintesis-background" data-page-background aria-hidden="true"></canvas>}
      {showHeader && <Header locale={locale} />}
      <slot />
    </div>
    {
      !usesHomeScenes && (
        <script is:inline define:vars={{ sceneMode }}>
          const pageBackground = document.querySelector("[data-page-background]")
          if (pageBackground) {
            import("/scenes/fondo.js").then((module) => {
              const scene = module.mount(pageBackground, { reduced: matchMedia("(prefers-reduced-motion: reduce)").matches })
              scene.setMode(sceneMode)
              addEventListener("scroll", () => scene.setScroll(scrollY), { passive: true })
            })
          }
        </script>
      )
    }
    <script is:inline>
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches
      const revealTargets = [...document.querySelectorAll("[data-reveal]")]

      if (reduceMotion || document.visibilityState === "hidden") {
        revealTargets.forEach((element) => element.classList.add("is-visible"))
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              const delay = Number(entry.target.getAttribute("data-delay") ?? 0)
              window.setTimeout(() => entry.target.classList.add("is-visible"), delay)
              revealObserver.unobserve(entry.target)
            })
          },
          { rootMargin: "0px 0px -8% 0px" },
        )
        revealTargets.forEach((element) => revealObserver.observe(element))
      }

      document.addEventListener("click", (event) => {
        const link = event.target.closest("a[href]")
        if (!link || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
        const url = new URL(link.href, location.href)
        if (link.target || url.origin !== location.origin || url.pathname === location.pathname) return
        event.preventDefault()
        document.documentElement.classList.add("is-leaving")
        window.setTimeout(() => { location.href = url.href }, 380)
      })
    </script>
  </body>
</html>
